<robot name="dodobot">
    <material name="white">
        <color rgba="1 1 1 1"/>
    </material>

    <material name="blue">
        <color rgba="0 0.369 0.722 1"/>
    </material>

    <link name="base_link"/>

    <joint name="base_link_to_wheel_center_joint" type="fixed">
        <parent link="base_link"/>
        <child link="wheel_center_link"/>
        <origin xyz="0 0 0.0312" rpy="0 0 0"/>
    </joint>

    <link name="wheel_center_link">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <mesh filename="package://db_description/meshes/chassis.stl"/>
            </geometry>
            <material name="blue"/>
        </visual>

        <collision>
            <origin  xyz="-0.055 0 0.12" rpy="0 0 0"/>
            <geometry>
                <box size="0.21 0.24 0.3"/>
            </geometry>
        </collision>

        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <mass value="2.5"/>
            <inertia
                ixx="1.0" ixy="0.0" ixz="0.0"
                iyy="1.0" iyz="0.0"
                izz="1.0">
            </inertia>
        </inertial>
    </link>

    <link name="tilt_base_link">
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <mass value="0.01"/>
            <inertia
                ixx="1.0" ixy="0.0" ixz="0.0"
                iyy="1.0" iyz="0.0"
                izz="1.0">
            </inertia>
        </inertial>
    </link>

    <joint name="base_link_to_tilt_base_joint" type="fixed">
        <parent link="wheel_center_link"/>
        <child link="tilt_base_link"/>
        <!-- <origin xyz="0.04796 0.0 0.24785"/> -->  <!-- V1 offsets -->
        <origin xyz="0.026965 0.0 0.252434"/>  <!-- V2 offsets -->
    </joint>

    <joint name="tilt_base_to_camera_rotate_joint" type="revolute">
        <parent link="tilt_base_link"/>
        <child link="camera_rotate_link"/>
        <origin xyz="0 0 0"/>
        <limit effort="1000.0" lower="0.0" upper="0.548" velocity="0.5"/>
        <axis xyz="0 1 0"/>
    </joint>

    <link name="camera_rotate_link">
        <visual>
            <origin rpy="0 0 0" xyz="0 0 0"/>
            <geometry>
                <mesh filename="package://db_description/meshes/camera.stl"/>
            </geometry>
            <material name="white"/>
        </visual>

        <collision>
            <origin rpy="0 0 0" xyz="0 0 0"/>
            <geometry>
                <mesh filename="package://db_description/meshes/camera.stl"/>
            </geometry>
        </collision>

        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <mass value="0.05"/>
            <inertia
                ixx="1.0" ixy="0.0" ixz="0.0"
                iyy="1.0" iyz="0.0"
                izz="1.0">
            </inertia>
        </inertial>
    </link>

    <link name="camera_link"/>

    <joint name="camera_rotate_to_camera_link_joint" type="fixed">
        <parent link="camera_rotate_link"/>
        <child link="camera_link"/>
        <origin xyz="0.029824 0.0175 0.0155"/>
    </joint>


    <link name="linear_base_link">
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <mass value="0.01"/>
            <inertia
                ixx="1.0" ixy="0.0" ixz="0.0"
                iyy="1.0" iyz="0.0"
                izz="1.0">
            </inertia>
        </inertial>
    </link>

    <joint name="linear_base_to_base_link" type="fixed">
        <parent link="wheel_center_link"/>
        <child link="linear_base_link"/>
        <origin xyz="0.06046488 0.0 0.01825032"/>
    </joint>

    <joint name="linear_to_linear_base_link" type="prismatic">
        <parent link="linear_base_link"/>
        <child link="linear_link"/>
        <origin xyz="0 0 0"/>
        <axis xyz="0 0 1"/>
        <limit effort="1000.0" lower="0" upper="0.154" velocity="0.5"/>
    </joint>

    <link name="linear_link">
        <visual>
            <origin rpy="0 0 0" xyz="0 0 0"/>
            <geometry>
                <mesh filename="package://db_description/meshes/gripper.stl"/>
            </geometry>
            <material name="white"/>
        </visual>

        <collision>
            <origin rpy="0 0 0" xyz="0 0 0"/>
            <geometry>
                <mesh filename="package://db_description/meshes/gripper.stl"/>
            </geometry>
        </collision>

        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <mass value="0.5"/>
            <inertia
                ixx="1.0" ixy="0.0" ixz="0.0"
                iyy="1.0" iyz="0.0"
                izz="1.0">
            </inertia>
        </inertial>
    </link>

    <link name="gripper_link"/>

    <joint name="gripper_link_to_linear_joint" type="fixed">
        <parent link="linear_link"/>
        <child link="gripper_link"/>
        <origin xyz="0.144 0 0.0017"/>
    </joint>

    <link name="laser"/>

    <joint name="wheel_center_to_laser_joint" type="fixed">
        <parent link="wheel_center_link"/>
        <child link="laser"/>
        <origin xyz="0.005 -0.080 0.1697" rpy="0 0 1"/>
    </joint>
</robot>
